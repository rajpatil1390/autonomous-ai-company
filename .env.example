# LLM provider: anthropic, openai, grok, ollama, or fake (tests only)
LLM_PROVIDER=anthropic

# Configure the selected provider. Leave unused optional variables commented.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
MODEL_ANTHROPIC=replace-with-your-anthropic-model
# OPENAI_API_KEY=replace-with-your-openai-api-key
# MODEL_OPENAI=replace-with-your-openai-model
# XAI_API_KEY=replace-with-your-xai-api-key
# MODEL_GROK=replace-with-your-grok-model
OLLAMA_BASE_URL=http://localhost:11434
# MODEL_OLLAMA=replace-with-your-installed-ollama-model

# Shared generation defaults
TEMPERATURE=0.2
MAX_TOKENS=4096
LOG_LEVEL=INFO

# Authentication
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LangGraph checkpointing
CHECKPOINTING_ENABLED=false

# PostgreSQL audit storage (all connection values are required when enabled)
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=autonomous_ai_company
POSTGRES_USER=autonomous_ai_company
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# MLflow experiment tracking
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=autonomous-ai-company
# MLFLOW_ARTIFACT_LOCATION=replace-with-an-artifact-directory-or-URI

# OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=autonomous-ai-company
OTEL_EXPORTER=console
# OTEL_OTLP_ENDPOINT=http://localhost:4318

# Prometheus metrics
METRICS_ENABLED=true
METRICS_NAMESPACE=autonomous_ai_company
METRICS_SUBSYSTEM=
